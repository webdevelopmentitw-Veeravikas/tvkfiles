# Copy to .env and set a unique secret (min 24 characters)
# Admin login URL: http://localhost:5173/#<VITE_ADMIN_PORTAL_KEY>
VITE_ADMIN_PORTAL_KEY=change-me-to-a-long-random-secret-key

# Production API URL (Cloudflare Pages: set in dashboard → Settings → Environment variables)
# Example: https://api.yourdomain.com/api
# VITE_API_URL=https://api.yourdomain.com/api
